# KRONOS Supabase Configuration
# Replace these with your actual Supabase project URL and anon public key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# KRONOS AI Mission Control Endpoint (Optional override; defaults to ${EXPO_PUBLIC_SUPABASE_URL}/functions/v1/kronos-ai)
EXPO_PUBLIC_AI_API_URL=https://your-project-ref.supabase.co/functions/v1/kronos-ai
EXPO_PUBLIC_AI_API_KEY=

# Server-side Supabase Edge Function Secrets (Set via: supabase secrets set GEMINI_API_KEY=...)
# DO NOT put these in the React Native client bundle!
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...
